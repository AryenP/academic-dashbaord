{
  "manifest_version": 3,
  "name": "Runway for Gradescope and Canvas",
  "version": "0.1.0",
  "description": "Sends your Gradescope and Canvas deadlines, submission status and (only if you turn it on) released scores to your Runway runway.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.gradescope.com/*", "https://*.instructure.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.gradescope.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.instructure.com/courses/*/assignments*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Runway"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["parsers.js"],
      "matches": ["https://www.gradescope.com/*", "https://*.instructure.com/*"]
    }
  ]
}
